generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  createdReports Report[] @relation("createdReports")
  updatedReports Report[] @relation("updatedReports")
  viewableReports ReportViewer[]
}

enum ReportVisibility {
  PUBLIC
  PASSWORD
  RESTRICTED
}

model Report {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  description   String?
  html          String
  sizeBytes     Int              @default(0)
  views         Int              @default(0)
  allowComments Boolean          @default(false)
  visibility    ReportVisibility @default(PUBLIC)
  passwordHash  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdById String
  createdBy   User   @relation("createdReports", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("updatedReports", fields: [updatedById], references: [id])

  comments       Comment[]
  allowedViewers ReportViewer[]
}

model ReportViewer {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}

model Comment {
  id         String   @id @default(cuid())
  selector   String
  authorName String
  text       String
  createdAt  DateTime @default(now())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
