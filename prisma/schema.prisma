generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // null = signed up but has not confirmed the email yet (cannot sign in)
  emailVerified DateTime?
  createdAt    DateTime @default(now())

  createdReports Report[] @relation("createdReports")
  updatedReports Report[] @relation("updatedReports")
  viewableReports ReportViewer[]
  passwordResets  PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  comments           Comment[]
  notifications      Notification[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReportVisibility {
  PUBLIC
  PASSWORD
  RESTRICTED
}

model Report {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  description   String?
  html          String
  sizeBytes     Int              @default(0)
  views         Int              @default(0)
  allowComments Boolean          @default(false)
  visibility    ReportVisibility @default(PUBLIC)
  passwordHash  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Reports outlive the account that created them: deleting a user leaves the
  // report in place with no owner.
  createdById String?
  createdBy   User?   @relation("createdReports", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("updatedReports", fields: [updatedById], references: [id], onDelete: SetNull)

  comments       Comment[]
  allowedViewers ReportViewer[]
  assets         ReportAsset[]
  notifications  Notification[]
}

model ReportAsset {
  id          String   @id @default(cuid())
  path        String
  blobUrl     String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, path])
}

model ReportViewer {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}

model Comment {
  id         String   @id @default(cuid())
  selector   String
  // Which page of a multi-page (.zip) report the comment belongs to, relative
  // to /r/<slug>/ (including the query string). "" is the main page.
  page       String   @default("")
  authorName String
  text       String
  createdAt  DateTime @default(now())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Replies point at a top-level comment (one level of nesting). Deleting a
  // comment deletes its replies.
  // Set when the commenter was signed in; null for anonymous commenters.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  notifications Notification[]

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([parentId])
}

enum NotificationType {
  COMMENT // someone commented on a report you created
  REPLY   // someone replied to a comment you wrote
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  actorName String
  snippet   String
  page      String           @default("")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
